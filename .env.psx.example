# Copy this file to .env and fill ONLY your local values.
# Never commit your real key.

TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:20128/v1
OPENAI_COMPATIBLE_API_KEY=replace_with_your_new_omniroute_key

# OmniRoute can route the model automatically.
TRADINGAGENTS_DEEP_THINK_LLM=auto
TRADINGAGENTS_QUICK_THINK_LLM=auto
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_TEMPERATURE=0.0
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
